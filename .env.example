# =============================================================================
# KAI Ads — Environment Variables
# Copy this file to .env and fill in real values.
# Every value here is read centrally in src/lib/env.ts — nothing in the
# codebase reads process.env directly outside of that file.
# =============================================================================

# --- App ---------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (REQUIRED) ------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/kai_ads?schema=public"

# --- Better Auth (REQUIRED) ----------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth (Google Workspace login) -------------------------------
# https://console.cloud.google.com/apis/credentials
# Restrict to Workspace accounts (hd parameter / verified domains).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Microsoft OAuth (Microsoft 365 login) --------------------------------
# https://portal.azure.com -> App registrations
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=common

# --- Magic Link email delivery ---------------------------------------------
# REQUIRED. No default — app refuses to start without an explicit choice.
# EMAIL_PROVIDER = "resend" | "smtp" | "none" (explicit opt-out for local dev)
EMAIL_PROVIDER=none
EMAIL_FROM="KAI Ads <noreply@youragency.com>"

# Resend (https://resend.com/api-keys) — used when EMAIL_PROVIDER=resend
RESEND_API_KEY=""

# SMTP — used when EMAIL_PROVIDER=smtp
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=false

# --- File Storage (agency logos) ------------------------------------------
# REQUIRED. No default — app refuses to start without an explicit choice.
# STORAGE_PROVIDER = "s3" | "vercel-blob" | "none" (explicit opt-out for local dev)
STORAGE_PROVIDER=none

# S3 / S3-compatible (AWS S3, Cloudflare R2, MinIO) — used when STORAGE_PROVIDER=s3
STORAGE_BUCKET=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_URL=""

# Vercel Blob — used when STORAGE_PROVIDER=vercel-blob
# Set ONE of these two, depending on how the Blob store was connected:
#  - BLOB_READ_WRITE_TOKEN: classic token-based connection.
#  - BLOB_STORE_ID: store "Connected" to the Vercel project via OIDC — no
#    static token exists; Vercel auto-injects both this and the runtime
#    VERCEL_OIDC_TOKEN, and @vercel/blob resolves auth from them itself.
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""

# --- Registration policy ---------------------------------------------------
# Comma-separated list of personal email domains rejected at registration
# and join-request time. Extend without a code change.
PERSONAL_EMAIL_DOMAINS="gmail.com,yahoo.com,outlook.com,hotmail.com,live.com,icloud.com,aol.com,proton.me,protonmail.com,zoho.com,mail.com,gmx.com,yandex.com,rediffmail.com"

# --- Logging -----------------------------------------------------------
LOG_LEVEL=info

# --- Seed script (optional, dev-only) --------------------------------------
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_NAME="KAI Super Admin"

# --- KAI Intelligence Engine (Sprint 003) -----------------------------------
# Optional — without OPENAI_API_KEY, AI extraction reports itself as
# unavailable and the review screen falls back to manual entry. Model
# names are read ONLY from here — never hardcoded elsewhere in the app.
OPENAI_API_KEY=""
KAI_TEXT_MODEL=gpt-4.1-mini
KAI_VISION_MODEL=gpt-4.1-mini
KAI_IMAGE_MODEL=gpt-image-1

# --- Gemini ------------------------------------------------------------------
# Two independent keys/gates: text/extraction and image generation can be
# migrated or rolled back on separate schedules. Each key, when present,
# takes priority over OPENAI_API_KEY for its own stage; remove the key to
# fall straight back to OpenAI. Priority order, not runtime failover.
#
# When these are set, the KAI_*_MODEL values above must name Gemini models.
#
# PRODUCTION (current, business-mandated for ₹10/ad margin target):
#   KAI_TEXT_MODEL=gemini-3.5-flash-lite
#   KAI_VISION_MODEL=gemini-3.5-flash-lite
#   KAI_IMAGE_MODEL=gemini-3.1-flash-lite-image
#
# Image model evaluation (identical Creative Brief, 1024x1024, live API):
#   gemini-2.5-flash-image      REJECTED. Rendered a wrong phone number (one
#     digit dropped), filed a salary under "Benefits", duplicated section
#     headings, misspelled several words. Commercially unusable.
#   gemini-3-pro-image          REJECTED. Best-looking layout of the three,
#     but composes edge-to-edge and ran ad copy into the reserved bottom
#     strip in 4 of 4 samples — losing a position line, a contact number,
#     or half the benefits list on different runs. Also ~3.5x slower
#     (~25s vs ~7s) and the most expensive of the four.
#   gemini-3.1-flash-image      Quality-verified: 5 of 6 fresh-brief trials
#     clean, 1 minor typo, none clipped, ~7s. Higher per-image cost.
#   gemini-3.1-flash-lite-image PRODUCTION CHOICE, ~2.5s, lowest cost. Known
#     real-world defect rate from this session's trials: 2 of 4 fresh-brief
#     samples had a defect serious enough to reject (garbled/unreadable
#     headline text, or a clipped line) — roughly 50%, not the 0/2 an
#     earlier same-brief test suggested. Chosen anyway as an explicit
#     business decision prioritizing cost over that defect rate. Revisit if
#     regeneration volume erodes the margin this was chosen for.
GEMINI_TEXT_API_KEY=""
GEMINI_IMAGE_API_KEY=""
