// KAI Ads — Sprint 001: Authentication & Onboarding
// Prisma schema. PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/**
 * Agency-owned footer styles. These are brand furniture — the equivalent
 * of a letterhead — not advertisement templates: they never touch the
 * creative above the branding strip.
 */
enum FooterStyle {
  CLASSIC_CORPORATE
  TRADITIONAL_DTP
  INDUSTRIAL_PREMIUM
  MODERN_MINIMAL
  AI_PREMIUM
}

enum AgencyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum UserRole {
  KAI_SUPER_ADMIN
  AGENCY_ADMIN
  AGENCY_USER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ApprovalTargetType {
  AGENCY
  JOIN_REQUEST
}

enum ApprovalDecision {
  APPROVE
  REJECT
  SUSPEND
  ACTIVATE
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdvertisementStatus {
  DRAFT
  REVIEW
  APPROVED
  ARCHIVED
}

enum AdvertisementStyle {
  VISUAL
  TYPOGRAPHY
  NEWSPAPER
}

enum AdvertisementDraftSourceType {
  PASTE_TEXT
  PDF
  DOCX
  IMAGE
  WHATSAPP_SCREENSHOT
}

enum AdvertisementDraftStatus {
  UPLOADED
  EXTRACTING
  EXTRACTED
  EXTRACTION_FAILED
  REVIEWED
  STYLE_SELECTED
  SAVED
  DISCARDED
}

enum AiOperationType {
  REQUIREMENT_EXTRACTION
  TRADE_SUMMARY
  INDUSTRY_DETECTION
  COUNTRY_DETECTION
  EMPLOYER_DETECTION
  SALARY_DETECTION
  INTERVIEW_DETECTION
  COMPOSITE_EXTRACTION
  FULL_AD_GENERATION
  SECTION_REGENERATION
  THEME_VARIATION
  RETRY
  SYSTEM_RETRY
}

enum AdvertisementDensity {
  LOW
  MEDIUM
  HIGH
}

enum AdvertisementSection {
  HEADER
  COUNTRY_INDUSTRY
  POSITIONS
  BENEFITS
  INTERVIEW
  CONTACT
  AGENCY_FOOTER
  VERIFICATION_BADGE
}

enum RegenerationMethod {
  AI_REGENERATED
  MANUAL_EDIT
}

enum AdvertisementTrustStatus {
  TRUST_READY
  REVIEW_RECOMMENDED
  BLOCKED
}

enum AgencyVerificationStatus {
  UNVERIFIED
  VERIFIED
  SUSPENDED
  REVERIFICATION_REQUIRED
}

// ---------------------------------------------------------------------------
// Core domain models
// ---------------------------------------------------------------------------

model Agency {
  id                 String       @id @default(cuid())
  name               String
  registrationNumber String       @unique
  website            String
  officialEmail      String       @unique
  logoUrl            String
  secondaryLogoUrl   String?
  status             AgencyStatus @default(PENDING)

  // Agency Profile — the single source of truth for branding on every
  // advertisement. Agency-editable; the recruiter never retypes these per
  // campaign. Nullable so existing agencies keep working before they
  // complete their profile.
  contactPerson String?
  phone         String?
  whatsapp      String?
  officeAddress String?
  /** Optional brand accents, e.g. { "primary": "#0B1F33" }. */
  brandColours  Json?
  /** Optional handles, e.g. { "facebook": "https://..." }. */
  socialLinks   Json?
  /** Up to three permanent branding claims, e.g. ["Since 1984", "ISO Certified"]. */
  brandBadges   Json?
  /**
   * The agency's preferred footer. Null means KAI picks the style that
   * best matches each generated advertisement.
   */
  footerStyle   FooterStyle?

  domains      Domain[]
  users        User[]
  joinRequests JoinRequest[]
  approvals    Approval[]
  auditLogs    AuditLog[]

  employers            Employer[]
  jobOrders            JobOrder[]
  requirementSources   RequirementSource[]
  advertisements       Advertisement[]
  advertisementDrafts  AdvertisementDraft[]
  contacts             AgencyContact[]
  aiUsageLogs          AiUsageLog[]
  verification         AgencyVerification?
  generationQuota      AgencyGenerationQuota?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("agencies")
}

model Domain {
  id        String   @id @default(cuid())
  domain    String   @unique
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([agencyId])
  @@map("domains")
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  role          UserRole   @default(AGENCY_USER)
  status        UserStatus @default(PENDING)

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  sessions      Session[]
  accounts      Account[]
  joinRequests  JoinRequest[] @relation("JoinRequestUser")
  reviewedJoins JoinRequest[] @relation("JoinRequestReviewer")
  approvalsMade Approval[]    @relation("ApprovalActor")
  auditLogs     AuditLog[]

  createdAdvertisements Advertisement[]        @relation("AdvertisementCreatedBy")
  advertisementVersions AdvertisementVersion[] @relation("AdvertisementVersionCreatedBy")
  advertisementHistory  AdvertisementHistory[] @relation("AdvertisementHistoryActor")
  advertisementDrafts   AdvertisementDraft[]   @relation("AdvertisementDraftCreatedBy")
  jobOrders             JobOrder[]             @relation("JobOrderCreatedBy")
  createdContacts       AgencyContact[]        @relation("AgencyContactCreatedBy")
  aiUsageLogs           AiUsageLog[]
  verifiedAgencies      AgencyVerification[]   @relation("AgencyVerificationVerifiedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([role])
  @@map("users")
}

model JoinRequest {
  id       String            @id @default(cuid())
  userId   String
  user     User              @relation("JoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  agencyId String
  agency   Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  status   JoinRequestStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("JoinRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, status])
  @@map("join_requests")
}

model Approval {
  id         String             @id @default(cuid())
  targetType ApprovalTargetType
  targetId   String
  decision   ApprovalDecision
  reason     String?

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation("ApprovalActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@map("approvals")
}

model AuditLog {
  id       String  @id @default(cuid())
  action   String
  entity   String
  entityId String
  metadata Json?

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([agencyId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Advertisement Intelligence Engine (Sprint 002)
//
// Architecture only in this sprint: no AI provider implementation, no
// rendering, no export. Advertisement content fields (positions, benefits,
// interview, contact, theme) are stored as Json — the Golden Rule
// ("editing one block must never affect other blocks") is enforced at the
// service layer, not by rigid columns, since the exact shape of each block
// is still expected to evolve once the AI Extraction and rendering engines
// are built in later sprints.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Permanent business domain (Task 001)
// ---------------------------------------------------------------------------

/**
 * Employer — the foreign principal a JobOrder hires for.
 *
 * Before this existed, the employer was a free-text column on each
 * advertisement, so "everything we have ever run for ABC Contracting"
 * was not an answerable question at any speed. Promoting it to an entity
 * is what makes employer memory possible at all.
 *
 * Scoped per agency: two agencies working with the same principal each
 * keep their own record and their own history. `normalizedName` is the
 * de-duplication key (see src/lib/normalize-entity-name.ts) so
 * "ABC Contracting", "abc  contracting" and " ABC Contracting " resolve
 * to one employer instead of three.
 */
model Employer {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  /** As written by the recruiter/source — displayed verbatim, never normalized for display. */
  name String
  /** Lowercased, whitespace-collapsed form. De-duplication key only; never rendered. */
  normalizedName String

  jobOrders JobOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, normalizedName])
  @@index([agencyId])
  @@map("employers")
}

/**
 * JobOrder — the root business entity.
 *
 * A JobOrder is one hiring requirement, from one employer, for one
 * destination. The advertisement is an artifact OF the job order, not
 * the other way round: one requirement can produce several
 * advertisements over its life, and the requirement outlives all of them.
 *
 * Every existing advertisement was backfilled to exactly one JobOrder by
 * the accompanying migration, so nothing is orphaned and no history is
 * lost. Advertisement.jobOrderId stays nullable for backward
 * compatibility — no existing read path is forced to join through here.
 */
model JobOrder {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  employerId String?
  employer   Employer? @relation(fields: [employerId], references: [id], onDelete: SetNull)

  /** Human-facing summary of the requirement — seeded from the advertisement header. */
  title    String
  industry String
  country  String

  /** Interview date/venue/mode for this requirement, same shape as Advertisement.interview. */
  interview Json?

  positions      Position[]
  advertisements Advertisement[]

  // Task 002 — Requirement Intelligence. Virtual back-relations only:
  // Prisma requires both sides of a relation to be declared, but these
  // add NO column to job_orders. The Task 001 table is untouched.
  requirementSources RequirementSource[]
  requirementFacts   RequirementFact[]

  // Task 003 — JobOrder Intelligence. Virtual back-relation only; adds
  // no column to job_orders.
  determinations JobOrderDetermination[]

  // Task 004 — Compliance Intelligence. Virtual back-relation only.
  complianceDeterminations ComplianceDetermination[]

  // Task 005 — Campaign Intelligence. Virtual back-relation only.
  campaignDeterminations CampaignDetermination[]

  createdById String
  createdBy   User   @relation("JobOrderCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, createdAt])
  @@index([agencyId, country])
  @@index([agencyId, industry])
  @@index([employerId])
  @@map("job_orders")
}

/**
 * Position — one trade line within a JobOrder, as a queryable record.
 *
 * The same data continues to live in Advertisement.positions (Json),
 * which remains the rendering pipeline's input and is untouched by this
 * change. This table is the queryable projection of it: counting
 * scaffolder demand across a year is a row scan here, and is impossible
 * against one jsonb blob per advertisement.
 *
 * `normalizedTitle` groups trade spellings ("Rigger III", "rigger  iii")
 * for aggregation; `title` is always what the source actually said.
 */
model Position {
  id         String   @id @default(cuid())
  jobOrderId String
  jobOrder   JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)

  title           String
  /** Lowercased, whitespace-collapsed form. Aggregation key only; never rendered. */
  normalizedTitle String

  count      Int?
  experience String?
  /** Source-verbatim salary text, never a parsed number — same rule as the advertisement block. */
  salary     String?
  ageRange   String?
  language   String?
  /** string[] — qualifications exactly as stated in the requirement. */
  qualifications Json?

  /** Preserves the order the positions appeared in the requirement. */
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobOrderId, sortOrder])
  @@index([normalizedTitle])
  @@map("positions")
}

// ---------------------------------------------------------------------------
// Requirement Intelligence (Task 002)
// ---------------------------------------------------------------------------

/** Every requirement channel the engine accepts. */
enum RequirementSourceKind {
  WHATSAPP_TEXT
  WHATSAPP_SCREENSHOT
  PDF
  IMAGE
  VOICE_NOTE
  EMAIL
  WORD
  EXCEL
  GOOGLE_SHEET
  WEBSITE
  PLAIN_TEXT
}

/** How a canonical value came to hold its form — the explainability axis. */
enum ExtractionMethod {
  /** A pure rule in requirement-normalization.ts produced it. Replayable. */
  DETERMINISTIC
  /** The model read it from the source; no canonicalization was needed. */
  AI_EXTRACTION
  /** The model read it, then a deterministic rule canonicalized it. */
  AI_THEN_NORMALIZED
  /** No source stated it. An explicit unknown, never a guess. */
  ABSENT
}

enum ConfidenceBand {
  HIGH
  MEDIUM
  LOW
}

/**
 * One inbound requirement artifact, exactly as received.
 *
 * Kept so that every fact can point at the thing it came from and a
 * recruiter (or a regulator) can be shown the original. `extractedText`
 * is what the engine actually read — the transcript of a voice note, the
 * cell text of a workbook — so an extraction can be re-explained later
 * without re-fetching a URL that may have changed.
 */
model RequirementSource {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  /** Set once the sources have produced a requirement. */
  jobOrderId String?
  jobOrder   JobOrder? @relation(fields: [jobOrderId], references: [id], onDelete: SetNull)

  kind  RequirementSourceKind
  /** Human label: file name, sheet name, or URL. */
  label String

  /** sha256 of the artifact — de-duplicates the same demand letter forwarded twice. */
  contentHash String

  /** Original location for link-based sources. Null for uploads and pasted text. */
  uri      String?
  mimeType String?

  /** What the engine actually read out of this artifact. */
  extractedText String? @db.Text

  /** string[] — non-fatal notes about how it was read (skipped sheets, followed redirects). */
  notes Json?

  createdAt DateTime @default(now())

  facts RequirementFact[]

  @@index([agencyId, contentHash])
  @@index([jobOrderId])
  @@map("requirement_sources")
}

/**
 * One extracted field, fully explained.
 *
 * Task 002's binding rule: every extracted field carries Source,
 * Confidence and Reason. This table IS that rule — a field without a
 * reason cannot be written, and absence is stored as a row with
 * method = ABSENT rather than as a missing row, so "the requirement did
 * not state a salary" is distinguishable from "nobody looked".
 */
model RequirementFact {
  id         String   @id @default(cuid())
  jobOrderId String
  jobOrder   JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)

  sourceId String?
  source   RequirementSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  /** Canonical dotted path, e.g. "country", "positions.0.salary". */
  field String

  /** Canonical value as stored on the JobOrder, or null when absent. */
  value String? @db.Text
  /** Exactly what the source said, before canonicalization. */
  rawValue String? @db.Text

  sourceKind RequirementSourceKind
  /** Where inside the source, e.g. "sheet 'Demand' row 12". */
  sourceRef String?

  /** 0–1, deterministic — see requirement-provenance.ts. */
  confidence     Float
  confidenceBand ConfidenceBand
  method         ExtractionMethod

  /** Plain-language explanation. Never empty. */
  reason String @db.Text

  createdAt DateTime @default(now())

  @@unique([jobOrderId, field])
  @@index([jobOrderId])
  @@index([jobOrderId, confidenceBand])
  @@map("requirement_facts")
}

// ---------------------------------------------------------------------------
// JobOrder Intelligence (Task 003)
// ---------------------------------------------------------------------------

/**
 * One understanding of one requirement, attached to the JobOrder.
 *
 * The engine determines industry, sector, plant type, plant status, trade
 * categories, scarcity, complexity, urgency, hiring pattern, recruitment
 * pattern and suggested channels — and records each with the evidence
 * that produced it.
 *
 * Every row carries Source, Confidence and Reason, the same contract the
 * Requirement Intelligence engine established. `reason` is NOT NULL: the
 * engine may return UNKNOWN, but it may never return a value it cannot
 * explain.
 *
 * UNKNOWN is stored as a row with value = 'UNKNOWN' rather than as a
 * missing row, so "we looked and could not tell" stays distinguishable
 * from "this was never assessed". Acting on the first is fine; acting on
 * the second is how a wrong advertisement gets published.
 *
 * Derived data: it is recomputed, not migrated. `computedAt` and
 * `engineVersion` make a stale set detectable.
 */
model JobOrderDetermination {
  id         String   @id @default(cuid())
  jobOrderId String
  jobOrder   JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)

  /** Stable machine name, e.g. "industry", "plantStatus", "recruitmentPattern". */
  attribute String
  /** The determined value, or the literal 'UNKNOWN'. */
  value String @db.Text

  /** 0–100. Zero whenever the value is UNKNOWN. */
  confidencePct Int
  /** Where the evidence came from, e.g. "position title, source text". */
  source String
  /** Plain-language explanation. Never empty. */
  reason String @db.Text
  /** string[] — the exact evidence that fired, for display and audit. */
  signals Json?

  /** Which build of the taxonomy produced this, so a re-run is comparable. */
  engineVersion String
  computedAt    DateTime @default(now())

  @@unique([jobOrderId, attribute])
  @@index([jobOrderId])
  @@index([attribute, value])
  @@map("job_order_determinations")
}

// ---------------------------------------------------------------------------
// Compliance Intelligence (Task 004)
// ---------------------------------------------------------------------------

enum ComplianceCategory {
  EMPLOYER_DISCLOSURE
  AGENCY_DISCLOSURE
  COUNTRY_RULE
  CORRIDOR_RULE
  MANDATORY_WARNING
  LEGAL_STATEMENT
  TRUST_ELEMENT
  FORBIDDEN_CLAIM
}

enum ComplianceStatus {
  /** The rule applies and is satisfied by what is on record. */
  SATISFIED
  /** The rule applies and something is still needed. */
  REQUIRED
  /** The rule applies and the record contradicts it. */
  VIOLATED
  /** No rule of this kind exists in the knowledge base for this corridor. */
  NOT_IN_KNOWLEDGE_BASE
  /** The corridor is outside the knowledge base's declared coverage. */
  UNKNOWN
}

/**
 * Whether a rule has been checked by a qualified reviewer.
 *
 * Stored per determination so the difference between "encoded from public
 * sources by an engineer" and "confirmed by someone qualified to confirm
 * it" survives into the database, instead of being lost the moment the
 * determination is written.
 */
enum ComplianceReviewStatus {
  REQUIRES_LEGAL_REVIEW
  REVIEWED
}

/**
 * One compliance requirement determined for one requirement.
 *
 * Every row carries Source, Confidence and Reason — the contract Tasks
 * 002 and 003 established. `reason` is NOT NULL: the engine may answer
 * UNKNOWN, but it may never assert a legal requirement it cannot explain.
 *
 * UNKNOWN is stored as a row rather than as absence, and that matters
 * more here than anywhere else in the pipeline. "No requirements apply"
 * and "we have no rules for this corridor" look identical as an empty
 * list and are opposite answers in front of a regulator.
 *
 * Derived data: recomputed, never migrated.
 */
model ComplianceDetermination {
  id         String   @id @default(cuid())
  jobOrderId String
  jobOrder   JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)

  /** Rule id, or `CATEGORY:summary` for a category-level verdict. */
  code     String
  category ComplianceCategory
  status   ComplianceStatus

  /** The applicable requirement, or the literal 'UNKNOWN'. */
  value String @db.Text

  /** 0–100. Zero whenever the value is UNKNOWN. */
  confidencePct Int
  source        String
  /** Plain-language explanation. Never empty. */
  reason        String @db.Text

  /** The legal instrument. Null for coverage-gap and record-gap rows. */
  authority String?
  /** Precise reference where genuinely known — never fabricated. */
  citation  String?

  reviewStatus ComplianceReviewStatus?

  engineVersion String
  computedAt    DateTime @default(now())

  @@unique([jobOrderId, code])
  @@index([jobOrderId])
  @@index([category, status])
  @@map("compliance_determinations")
}

// ---------------------------------------------------------------------------
// Campaign Intelligence (Task 005)
// ---------------------------------------------------------------------------

/**
 * One communication decision for one requirement.
 *
 * Decides HOW the requirement should be communicated — objective,
 * messages, motivation, trust posture, tone, audience, CTA, and what a
 * hero image should depict. It decides nothing about layout, typography,
 * colour or position: those belong to Layout Intelligence and the
 * Rendering Engine, which run later.
 *
 * `dependsOn` records which upstream determinations the decision was
 * derived from. That is what makes a campaign traceable: an UNKNOWN here
 * points at the exact gap in JobOrder or Compliance Intelligence that
 * caused it, rather than appearing as an unexplained blank.
 *
 * Derived data: recomputed, never migrated.
 */
model CampaignDetermination {
  id         String   @id @default(cuid())
  jobOrderId String
  jobOrder   JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)

  /** Stable machine name, e.g. "primaryCommunicationMessage", "heroImageIntent". */
  attribute String
  /** The communication decision, or the literal 'UNKNOWN'. */
  value String @db.Text

  /** 0–100. Zero whenever the value is UNKNOWN. Capped by the least certain input. */
  confidencePct Int
  source        String
  /** Plain-language explanation. Never empty. */
  reason        String @db.Text

  /** string[] — the upstream attributes this was derived from. */
  dependsOn Json?

  engineVersion String
  computedAt    DateTime @default(now())

  @@unique([jobOrderId, attribute])
  @@index([jobOrderId])
  @@map("campaign_determinations")
}

model Advertisement {
  id     String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  /**
   * The requirement this advertisement was produced for. Nullable so
   * every existing read path, API response and test keeps working
   * unchanged; the service layer always populates it on create.
   */
  jobOrderId String?
  jobOrder   JobOrder? @relation(fields: [jobOrderId], references: [id], onDelete: SetNull)

  // --- Advertisement Schema (Sprint 002 brief) ---
  header   String
  industry String
  country  String
  employer String? // Optional per schema
  positions Json // structured list of positions/requirements
  benefits  Json // structured list of benefits
  interview Json // interview date/location/contact details
  contact   Json // agency contact block shown on the ad
  footer    String?
  theme     Json? // free-form theme/trust-stamp flags, "store only"

  style  AdvertisementStyle @default(VISUAL)
  status AdvertisementStatus @default(DRAFT)

  // --- Sprint 004: generation, density, trust, tracking ---
  // platformFormat is a String key into a centralized TS registry
  // (src/lib/platform-formats.ts), not a DB enum — the brief requires
  // "architecture must support adding future platforms without
  // rewriting the generation engine," which a growing DB enum would defeat.
  platformFormat   String?
  density          AdvertisementDensity?
  generatedAssetUrl String? // the composed/rendered advertisement image, once generated
  badgeConfig      Json? // { shape, size } chosen by KAI for the unified verification QR badge
  trustStatus      AdvertisementTrustStatus?
  trustWarnings    Json? // string[] — reasons trustStatus isn't TRUST_READY

  currentVersion Int @default(1)

  createdById String
  createdBy   User   @relation("AdvertisementCreatedBy", fields: [createdById], references: [id])

  sourceDraftId String? @unique
  sourceDraft   AdvertisementDraft? @relation("DraftResultAdvertisement", fields: [sourceDraftId], references: [id])

  duplicatedFromId String?
  duplicatedFrom   Advertisement?  @relation("AdvertisementDuplicates", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicates       Advertisement[] @relation("AdvertisementDuplicates")

  versions AdvertisementVersion[] @relation("AdvertisementVersions")
  history  AdvertisementHistory[]
  qrScanEvents QrScanEvent[]

  deletedAt DateTime? // soft delete ("trash"), distinct from ARCHIVED status

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, status])
  @@index([agencyId, deletedAt])
  @@index([agencyId, industry])
  @@index([agencyId, country])
  @@index([agencyId, createdAt])
  @@index([jobOrderId])
  @@map("advertisements")
}

model AdvertisementVersion {
  id              String @id @default(cuid())
  advertisementId String

  advertisement Advertisement @relation("AdvertisementVersions", fields: [advertisementId], references: [id], onDelete: Cascade)

  versionNumber Int
  snapshot      Json // full snapshot of every editable field at this version
  changeSummary String? // doubles as "reason if provided" per the brief

  // Critical Editing USP: which section changed and how, so an edit to
  // one section is provably isolated rather than a full regeneration.
  changedSection      AdvertisementSection?
  regenerationMethod  RegenerationMethod?
  previousSectionData Json? // the changed section's content before this version
  newSectionData      Json? // the changed section's content after this version

  createdById String
  createdBy   User   @relation("AdvertisementVersionCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@unique([advertisementId, versionNumber])
  @@index([advertisementId])
  @@map("advertisement_versions")
}

model AdvertisementHistory {
  id              String @id @default(cuid())
  advertisementId String

  advertisement Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  action     String // created | updated | status_changed | duplicated | archived | restored | deleted | undeleted
  fromStatus AdvertisementStatus?
  toStatus   AdvertisementStatus?
  metadata   Json?

  actorId String
  actor   User   @relation("AdvertisementHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([advertisementId, createdAt])
  @@map("advertisement_history")
}

model AdvertisementDraft {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  sourceType    AdvertisementDraftSourceType
  rawText       String? // Paste Requirement input
  sourceFileUrl String? // Upload PDF / DOCX / Image / WhatsApp Screenshot

  // ChatGPT-style composer (Supreme Constitution Principle 12): one draft
  // can carry several sources at once — typed text, pasted images, and
  // mixed PDF/DOCX/image uploads together. `attachments` is an array of
  // { url, sourceType, fileName, mimeType }; `instructions` is the
  // recruiter's free-typed guidance alongside those attachments. Both are
  // additive — rawText/sourceFileUrl keep working exactly as before for
  // every draft created by the older single-source form.
  attachments  Json?
  instructions String?

  // AI Extraction Review — populated by the KAI Intelligence Engine
  // (Sprint 003: a real OpenAI-backed implementation of the Sprint 002
  // provider interfaces). Nullable: extraction can fail (missing API key,
  // provider timeout, unsupported file) without losing the recruiter's
  // original rawText/sourceFileUrl — see extractionError.
  extractedData Json?
  extractionError String?

  // The recruiter's edited/approved version of extractedData — this is
  // what actually becomes the Advertisement on Save.
  reviewedData Json?

  selectedStyle AdvertisementStyle?

  status AdvertisementDraftStatus @default(UPLOADED)

  resultAdvertisement Advertisement? @relation("DraftResultAdvertisement")

  createdById String
  createdBy   User   @relation("AdvertisementDraftCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, status])
  @@index([createdById])
  @@map("advertisement_drafts")
}

// ---------------------------------------------------------------------------
// KAI Recruitment Intelligence Engine (Sprint 003)
// ---------------------------------------------------------------------------

/**
 * Contact Directory — "Do not ask the recruiter to type contact
 * information repeatedly." A reusable set of agency contacts selectable
 * on the AI Extraction Review screen; selecting one prefills the
 * Advertisement's `contact` Json block. No FK from Advertisement back to
 * here — the contact data is copied into the ad at save time (an ad's
 * contact block must stay correct even if the source contact is later
 * edited or removed), matching "Everything editable" per block.
 */
model AgencyContact {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  name        String
  mobile      String?
  whatsapp    String?
  email       String?
  designation String?

  createdById String
  createdBy   User   @relation("AgencyContactCreatedBy", fields: [createdById], references: [id])

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, deletedAt])
  @@map("agency_contacts")
}

/**
 * Cost Tracking — one row per AI operation. Never surfaced to normal
 * agency users (see src/server/ai README notes); exists so a future
 * credit/billing system has real usage data to calculate from on day one
 * instead of needing a backfill.
 */
model AiUsageLog {
  id String @id @default(cuid())

  operationType AiOperationType
  provider      String // e.g. "openai" — never shown to agency users
  model         String // e.g. the resolved KAI_TEXT_MODEL/KAI_VISION_MODEL value

  inputTokens  Int?
  outputTokens Int?
  estimatedCostUsd Decimal? @db.Decimal(10, 6)
  latencyMs    Int?

  // Sprint 004: image generation specifics. Nullable — text extraction
  // rows (Sprint 003) never set these.
  imageSize    String?
  imageQuality String?
  // "Do not charge or consume user quota for system failures" — a failed
  // provider execution is recorded (success=false) but billable=false,
  // so quota accounting can filter on this instead of inferring it from
  // success, which conflates "we tried and failed" with "should count."
  billable Boolean @default(true)

  success      Boolean
  errorMessage String?

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  advertisementDraftId    String?
  advertisementId         String?
  advertisementVersionId  String?

  createdAt DateTime @default(now())

  @@index([agencyId, createdAt])
  @@index([operationType])
  @@index([advertisementId])
  @@map("ai_usage_logs")
}

/**
 * Agency Verification Workflow (Sprint 004). One row per Agency — created
 * the moment a KAI Super Admin first verifies (or explicitly marks
 * unverified) an agency. `id` is the "permanent Agency Verification ID"
 * the brief requires, kept distinct from Agency.id so it can be used in
 * public-facing QR/tracking URLs without implying anything about
 * internal record structure.
 */
model AgencyVerification {
  id       String @id @default(cuid())
  agencyId String @unique
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  status                  AgencyVerificationStatus @default(UNVERIFIED)
  officialVerificationUrl String? // the real Government of India / eMigrate destination the QR ultimately redirects to
  verificationDate        DateTime?
  verifiedById            String?
  verifiedBy              User?     @relation("AgencyVerificationVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  evidenceReference       String?
  licenseValidUntil       DateTime?
  reverificationRequired  Boolean   @default(false)
  notes                   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("agency_verifications")
}

/**
 * Bootstrap Trial Quota (Sprint 004). One row per Agency. Quota belongs
 * to the agency, not any one employee — every user in the agency draws
 * from the same counters. No payment collection yet; usage tracking only.
 */
model AgencyGenerationQuota {
  id       String @id @default(cuid())
  agencyId String @unique
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  totalQuota               Int @default(50) // closed beta: 50 complimentary generations per approved agency
  successfulGenerationsUsed Int @default(0)
  sectionRegenerationCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agency_generation_quotas")
}

/**
 * QR Scan Intelligence (Sprint 004). Privacy-preserving by design: no
 * candidate identity, no login/registration, no indefinitely-retained
 * raw IP — only approximate geography and device category, and only
 * what's needed to answer "which advertisement/version drove this scan."
 */
model QrScanEvent {
  id String @id @default(cuid())

  advertisementId        String
  advertisement           Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  advertisementVersionId  String?

  sourcePlatform   String?
  countryCode      String? // approximate, from request geolocation — never raw IP
  region           String?
  city             String?
  deviceCategory   String?
  referrer         String?

  destinationUrl   String? // the official verification URL redirected to at scan time
  redirectSuccess  Boolean

  scannedAt DateTime @default(now())

  @@index([advertisementId, scannedAt])
  @@map("qr_scan_events")
}



model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}
